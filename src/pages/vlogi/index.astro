---
import BaseLayout from "../../layouts/BaseLayout.astro";
import VideoCard from "../../components/VideoCard.astro";
import { Play } from "@lucide/astro";
import { getCollection } from "astro:content";
import { buildPostHref, buildVlogCategoryHref } from "../../utils/urls";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
import { getVlogFilterChips, isVlogPost } from "../../data/categories";

const allVideos = await getCollection("blog");
const published = allVideos
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const videos = published.filter((p) => isVlogPost(p));
const filterList = getVlogFilterChips(published);

// Featured: explicit override or fallback to most recent
const featuredVideo = videos.find((v) => v.data.featured) ?? videos[0];

const listFrom = "/vlogi";
---

<BaseLayout
  title={`Vlogi | ${SITE_TITLE}`}
  description={SITE_DESCRIPTION}
  activePage="vlogi"
>
  <section class="vlogi-page">
    <div class="vlogi-header">
      <span class="section-label">VIDEO</span>
      <h1 class="section-title">Zadnji Videi</h1>
      <p class="section-subtitle">Kaj dogaja na poti, ampak v videu.</p>
    </div>

    <div class="category-filters">
      {
        filterList.map((cat) => (
          <a
            href={buildVlogCategoryHref(cat)}
            class:list={["filter-btn", { active: cat === "Vse" }]}
          >
            {cat === "Vse" ? "VSE" : cat}
          </a>
        ))
      }
    </div>

    {
      featuredVideo ? (
        <>
          <div class="featured-section">
            <a
              href={buildPostHref(featuredVideo.id, { from: listFrom })}
              class="featured-video-link"
            >
              <div class="featured-video-thumb">
                {featuredVideo.data.thumbnail ||
                featuredVideo.data.featureImage ? (
                  <img
                    src={
                      featuredVideo.data.featureImage ||
                      featuredVideo.data.thumbnail
                    }
                    alt={featuredVideo.data.title}
                    loading="eager"
                  />
                ) : (
                  <div class="featured-placeholder" />
                )}
                <div class="play-overlay">
                  <span class="play-icon" aria-hidden="true">
                    <Play size={24} stroke-width={2.5} />
                  </span>
                </div>
              </div>
            </a>
            <div class="featured-meta">
              <h2 class="featured-title">
                <a href={buildPostHref(featuredVideo.id, { from: listFrom })}>
                  {featuredVideo.data.title}
                </a>
              </h2>
              <p class="featured-date">
                {new Date(featuredVideo.data.pubDate).toLocaleDateString(
                  "sl-SI",
                  {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  },
                )}
                {featuredVideo.data.readTime
                  ? ` – ${featuredVideo.data.readTime} branja`
                  : ""}
              </p>
            </div>
          </div>

          <h3 class="video-list-title">Vsi videi</h3>
          <div class="row video-grid">
            {videos.map((entry) => (
              <div class="col-xs-12 col-md-6">
                <VideoCard
                  entry={entry}
                  featured={entry.id === featuredVideo?.id}
                  listFrom={listFrom}
                />
              </div>
            ))}
          </div>
        </>
      ) : (
        <div class="no-videos">
          <p>Še ni videov.</p>
        </div>
      )
    }
  </section>
</BaseLayout>

<style>
  .vlogi-page {
    padding: 2rem 0 4rem;
  }
  .vlogi-header {
    margin-bottom: 1.5rem;
  }
  .section-label {
    display: block;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 2.2px;
    color: var(--primary-base);
    margin-bottom: 0.5rem;
  }
  .section-title {
    font-family: var(--font-display);
    font-size: 2.625rem;
    font-weight: 700;
    margin: 0 0 0.25rem 0;
  }
  .section-subtitle {
    font-size: 15px;
    color: var(--grey-300);
    margin: 0;
  }
  .category-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }
  .filter-btn {
    padding: 8px 16px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    background: var(--grey-100);
    color: var(--black);
  }
  .filter-btn:hover,
  .filter-btn.active {
    background: var(--black);
    color: white;
  }
  .featured-section {
    background: rgba(230, 59, 46, 0.05);
    border: 1px solid rgba(230, 59, 46, 0.15);
    border-radius: 12.75px;
    padding: 21px;
    margin-bottom: 21px;
  }
  .featured-video-link {
    display: block;
    border-radius: 8.75px;
    overflow: hidden;
    aspect-ratio: 16/9;
    margin-bottom: 14px;
  }
  .featured-video-thumb {
    position: relative;
    width: 100%;
    height: 100%;
    background: var(--grey-200);
  }
  .featured-video-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .featured-placeholder {
    width: 100%;
    height: 100%;
    background: var(--grey-200);
  }
  .play-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.3);
  }
  .featured-section .play-icon {
    width: 48px;
    height: 48px;
  }
  .featured-meta {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .featured-title {
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: 700;
    line-height: 1.2;
    margin: 0;
  }
  .featured-title a {
    color: var(--black);
    text-decoration: none;
  }
  .featured-title a:hover {
    color: var(--primary-base);
  }
  .featured-date {
    font-size: 13px;
    color: var(--grey-300);
    margin: 0;
  }
  .video-list-title {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 600;
    margin: 0 0 14px 0;
  }
  .no-videos {
    padding: 4rem;
    text-align: center;
    color: var(--grey-400);
  }
</style>
