---
import BaseLayout from "../../layouts/BaseLayout.astro";
import VideoCard from "../../components/VideoCard.astro";
import { getCollection } from "astro:content";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";

const allVideos = await getCollection("blog");
const videos = allVideos
  .filter((p) => !p.data.draft && p.data.video)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Featured: explicit override or fallback to most recent
const featuredVideo = videos.find((v) => v.data.featured) ?? videos[0];
---

<BaseLayout
  title={`Vlogi | ${SITE_TITLE}`}
  description={SITE_DESCRIPTION}
  activePage="vlogi"
>
  <section class="vlogi-page">
    <div class="vlogi-header">
      <span class="section-label">VIDEO</span>
      <h1 class="section-title">Zadnji Videi</h1>
      <p class="section-subtitle">Kaj dogaja na poti, ampak v videu.</p>
    </div>

    {
      featuredVideo ? (
        <>
          <div class="featured-section">
            <a href={`/posts/${featuredVideo.id}`} class="featured-video-link">
              <div class="featured-video-thumb">
                {featuredVideo.data.thumbnail ||
                featuredVideo.data.featureImage ? (
                  <img
                    src={
                      featuredVideo.data.featureImage ||
                      featuredVideo.data.thumbnail
                    }
                    alt={featuredVideo.data.title}
                    loading="eager"
                  />
                ) : (
                  <div class="featured-placeholder" />
                )}
                <div class="play-overlay">
                  <span class="play-icon" aria-hidden="true">
                    ▶
                  </span>
                </div>
              </div>
            </a>
            <div class="featured-meta">
              <h2 class="featured-title">
                <a href={`/posts/${featuredVideo.id}`}>
                  {featuredVideo.data.title}
                </a>
              </h2>
              <p class="featured-date">
                {new Date(featuredVideo.data.pubDate).toLocaleDateString(
                  "sl-SI",
                  {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  },
                )}
                {featuredVideo.data.readTime
                  ? ` – ${featuredVideo.data.readTime} branja`
                  : ""}
              </p>
            </div>
          </div>

          <h3 class="video-list-title">Vsi videi</h3>
          <div class="video-grid">
            {videos.map((entry) => (
              <VideoCard
                entry={entry}
                featured={entry.id === featuredVideo?.id}
              />
            ))}
          </div>
        </>
      ) : (
        <div class="no-videos">
          <p>Še ni videov.</p>
        </div>
      )
    }
  </section>
</BaseLayout>

<style>
  .vlogi-page {
    padding: 2rem 0 4rem;
  }
  .vlogi-header {
    margin-bottom: 2rem;
  }
  .section-label {
    display: block;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 2.2px;
    color: var(--primary-base);
    margin-bottom: 0.5rem;
  }
  .section-title {
    font-family: var(--font-display);
    font-size: 2.625rem;
    font-weight: 700;
    margin: 0 0 0.25rem 0;
  }
  .section-subtitle {
    font-size: 15px;
    color: var(--grey-300);
    margin: 0;
  }
  .featured-section {
    background: rgba(230, 59, 46, 0.05);
    border: 1px solid rgba(230, 59, 46, 0.15);
    border-radius: 12.75px;
    padding: 21px;
    margin-bottom: 21px;
  }
  .featured-video-link {
    display: block;
    border-radius: 8.75px;
    overflow: hidden;
    aspect-ratio: 16/9;
    margin-bottom: 14px;
  }
  .featured-video-thumb {
    position: relative;
    width: 100%;
    height: 100%;
    background: var(--grey-200);
  }
  .featured-video-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .featured-placeholder {
    width: 100%;
    height: 100%;
    background: var(--grey-200);
  }
  .play-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.3);
  }
  .play-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.9);
    border-radius: 999px;
    font-size: 18px;
    color: var(--black);
  }
  .featured-meta {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .featured-title {
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: 700;
    line-height: 1.2;
    margin: 0;
  }
  .featured-title a {
    color: var(--black);
    text-decoration: none;
  }
  .featured-title a:hover {
    color: var(--primary-base);
  }
  .featured-date {
    font-size: 13px;
    color: var(--grey-300);
    margin: 0;
  }
  .video-list-title {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 600;
    margin: 0 0 14px 0;
  }
  .video-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 21px 21px;
  }
  .no-videos {
    padding: 4rem;
    text-align: center;
    color: var(--grey-400);
  }
  @media (max-width: 900px) {
    .video-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
