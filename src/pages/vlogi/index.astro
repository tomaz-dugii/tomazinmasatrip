---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const allVideos = await getCollection('blog');
const videos = allVideos
  .filter((p) => !p.data.draft && p.data.video)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featuredVideo = videos[0];
const otherVideos = videos.slice(1);
---

<BaseLayout title={`Vlogi | ${SITE_TITLE}`} description={SITE_DESCRIPTION} activePage="vlogi">
  <section class="vlogi-page">
    <div class="vlogi-header">
      <span class="section-label">VIDEO</span>
      <h1 class="section-title">Zadnji Videi</h1>
      <p class="section-subtitle">Kaj dogaja na poti, ampak v videu.</p>
    </div>
    <div class="vlogi-grid">
      <div class="featured-section">
        {featuredVideo ? (
          <>
            <a href={`/posts/${featuredVideo.id}`} class="featured-video-link">
              <div class="featured-video-thumb">
                {featuredVideo.data.thumbnail ? (
                  <img src={featuredVideo.data.thumbnail} alt={featuredVideo.data.title} />
                ) : (
                  <div class="featured-placeholder"></div>
                )}
                <div class="play-overlay">
                  <span class="play-icon">▶</span>
                </div>
              </div>
            </a>
            <div class="featured-meta">
              <h2 class="featured-title">
                <a href={`/posts/${featuredVideo.id}`}>{featuredVideo.data.title}</a>
              </h2>
              <p class="featured-date">
                {new Date(featuredVideo.data.pubDate).toLocaleDateString('sl-SI', { year: 'numeric', month: 'long', day: 'numeric' })}
                {featuredVideo.data.readTime ? ` – ${featuredVideo.data.readTime} branja` : ''}
              </p>
            </div>
          </>
        ) : (
          <div class="no-videos">
            <p>Še ni videov.</p>
          </div>
        )}
      </div>
      <div class="video-list-section">
        <h3 class="video-list-title">Vsi videi</h3>
        <div class="video-list">
          {videos.map((entry, i) => {
            const isActive = i === 0;
            const formattedDate = new Date(entry.data.pubDate).toLocaleDateString('sl-SI', { year: 'numeric', month: 'long', day: 'numeric' });
            return (
              <a href={`/posts/${entry.id}`} class={`video-item ${isActive ? 'active' : ''}`}>
                <div class="video-thumb">
                  {entry.data.thumbnail ? (
                    <img src={entry.data.thumbnail} alt={entry.data.title} />
                  ) : (
                    <div class="thumb-placeholder"></div>
                  )}
                  <div class="play-overlay-small">
                    <span class="play-icon-small">▶</span>
                  </div>
                </div>
                <div class="video-info">
                  <h4 class="video-item-title">{entry.data.title}</h4>
                  <span class="video-item-date">{formattedDate}</span>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .vlogi-page {
    padding: 2rem 0 4rem;
  }
  .vlogi-header {
    margin-bottom: 2rem;
  }
  .section-label {
    display: block;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 2.2px;
    color: var(--primary-base);
    margin-bottom: 0.5rem;
  }
  .section-title {
    font-family: var(--font-display);
    font-size: 2.625rem;
    font-weight: 700;
    margin: 0 0 0.25rem 0;
  }
  .section-subtitle {
    font-size: 15px;
    color: var(--grey-300);
    margin: 0;
  }
  .vlogi-grid {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 2.5rem;
    align-items: start;
  }
  .featured-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .featured-video-link {
    display: block;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.1);
    aspect-ratio: 16/9;
  }
  .featured-video-thumb {
    position: relative;
    width: 100%;
    height: 100%;
    background: var(--grey-200);
  }
  .featured-video-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .featured-placeholder {
    width: 100%;
    height: 100%;
    background: var(--grey-200);
  }
  .play-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.3);
  }
  .play-icon {
    width: 64px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.9);
    border-radius: 999px;
    font-size: 24px;
    color: var(--black);
  }
  .featured-meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .featured-title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    margin: 0;
  }
  .featured-title a {
    color: var(--black);
    text-decoration: none;
  }
  .featured-title a:hover {
    color: var(--primary-base);
  }
  .featured-date {
    font-size: 13px;
    color: var(--grey-300);
    margin: 0;
  }
  .no-videos {
    padding: 4rem;
    text-align: center;
    color: var(--grey-400);
  }
  .video-list-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .video-list-title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    margin: 0;
  }
  .video-list {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }
  .video-item {
    display: flex;
    gap: 0.75rem;
    padding: 10px;
    border-radius: 12.75px;
    text-decoration: none;
    color: inherit;
    border: 1px solid transparent;
    transition: background 0.2s, border-color 0.2s;
  }
  .video-item:hover {
    background: rgba(230, 59, 46, 0.03);
  }
  .video-item.active {
    background: rgba(230, 59, 46, 0.05);
    border-color: rgba(230, 59, 46, 0.15);
  }
  .video-item.active .video-item-title {
    color: var(--primary-base);
  }
  .video-thumb {
    position: relative;
    flex-shrink: 0;
    width: 100px;
    height: 66px;
    border-radius: 8.75px;
    overflow: hidden;
    background: var(--grey-100);
  }
  .video-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .thumb-placeholder {
    width: 100%;
    height: 100%;
    background: var(--grey-200);
  }
  .play-overlay-small {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.3);
  }
  .play-icon-small {
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.9);
    border-radius: 999px;
    font-size: 10px;
    color: var(--black);
  }
  .video-info {
    min-width: 0;
  }
  .video-item-title {
    font-size: 13px;
    font-weight: 600;
    line-height: 1.4;
    margin: 0 0 0.25rem 0;
    color: var(--black);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .video-item-date {
    font-size: 11px;
    font-weight: 500;
    color: var(--grey-300);
  }
  @media (max-width: 900px) {
    .vlogi-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
