---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import VideoCard from "../../../../../components/VideoCard.astro";
import { Play } from "@lucide/astro";
import { getCollection } from "astro:content";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../../../../consts";
import {
  getVlogCategoryPathSlugs,
  getVlogFilterChips,
  matchesVlogCategoryPage,
} from "../../../../../data/categories";
import {
  buildPostHref,
  buildVlogCategoryHref,
  buildVlogCategoryPageHref,
} from "../../../../../utils/urls";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog");
  const published = allPosts.filter((p) => !p.data.draft);
  const slugs = getVlogCategoryPathSlugs(published);
  const paths: { params: { category: string; page: string } }[] = [];
  const pageSize = 6;
  for (const cat of slugs) {
    const videos = published.filter((p) => matchesVlogCategoryPage(p, cat));
    const totalPages = Math.ceil(videos.length / pageSize);
    for (let p = 2; p <= totalPages; p++) {
      paths.push({ params: { category: cat, page: String(p) } });
    }
  }
  return paths;
}

const { category, page } = Astro.params;
const decodedCategory = category ? decodeURIComponent(category) : "";
const currentPage = parseInt(page ?? "1", 10);

const allPosts = await getCollection("blog");
const published = allPosts
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const videos = published.filter((p) =>
  matchesVlogCategoryPage(p, decodedCategory),
);
const filterList = getVlogFilterChips(published);

const pageSize = 6;
const totalPages = Math.max(1, Math.ceil(videos.length / pageSize));
const start = (currentPage - 1) * pageSize;
const paginatedVideos = videos.slice(start, start + pageSize);
const primaryVideo =
  paginatedVideos.length === 0
    ? undefined
    : (paginatedVideos.find((v) => v.data.featured) ?? paginatedVideos[0]);
const listFrom = buildVlogCategoryPageHref(decodedCategory, currentPage);
---

<BaseLayout
  title={`${decodedCategory} - stran ${currentPage} | Vlogi | ${SITE_TITLE}`}
  description={SITE_DESCRIPTION}
  activePage="vlogi"
>
  <section class="vlogi-page">
    <div class="vlogi-header">
      <span class="section-label">VIDEO · {decodedCategory}</span>
      <h1 class="section-title">Zadnji Videi</h1>
      <p class="section-subtitle">Kaj dogaja na poti, ampak v videu.</p>
    </div>

    <div class="category-filters">
      {
        filterList.map((cat) => (
          <a
            href={buildVlogCategoryHref(cat)}
            class:list={[
              "filter-btn",
              { active: cat === decodedCategory },
            ]}
          >
            {cat === "Vse" ? "VSE" : cat}
          </a>
        ))
      }
    </div>

    {
      videos.length === 0 ? (
        <div class="no-videos">
          <p>Ni videov v tej kategoriji.</p>
        </div>
      ) : primaryVideo ? (
        <>
          <div class="featured-section">
            <a
              href={buildPostHref(primaryVideo.id, { from: listFrom })}
              class="featured-video-link"
            >
              <div class="featured-video-thumb">
                {primaryVideo.data.thumbnail ||
                primaryVideo.data.featureImage ? (
                  <img
                    src={
                      primaryVideo.data.featureImage ||
                      primaryVideo.data.thumbnail
                    }
                    alt={primaryVideo.data.title}
                    loading="eager"
                  />
                ) : (
                  <div class="featured-placeholder" />
                )}
                <div class="play-overlay">
                  <span class="play-icon" aria-hidden="true">
                    <Play size={24} stroke-width={2.5} />
                  </span>
                </div>
              </div>
            </a>
            <div class="featured-meta">
              <h2 class="featured-title">
                <a href={buildPostHref(primaryVideo.id, { from: listFrom })}>
                  {primaryVideo.data.title}
                </a>
              </h2>
              <p class="featured-date">
                {new Date(primaryVideo.data.pubDate).toLocaleDateString(
                  "sl-SI",
                  {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  },
                )}
                {primaryVideo.data.readTime
                  ? ` – ${primaryVideo.data.readTime} branja`
                  : ""}
              </p>
            </div>
          </div>

          <h3 class="video-list-title">Videi</h3>
          <div class="row video-grid">
            {paginatedVideos.map((entry) => (
              <div class="col-xs-12 col-md-6">
                <VideoCard
                  entry={entry}
                  featured={entry.id === primaryVideo.id}
                  listFrom={listFrom}
                />
              </div>
            ))}
          </div>

          <nav class="pagination">
            <a
              href={currentPage > 1
                ? buildVlogCategoryPageHref(decodedCategory, currentPage - 1)
                : "#"}
              class={currentPage <= 1 ? "disabled" : ""}>←</a
            >
            {
              Array.from({ length: Math.min(totalPages, 7) }, (_, i) => {
                const p = i + 1;
                const href = buildVlogCategoryPageHref(decodedCategory, p);
                return (
                  <a href={href} class={p === currentPage ? "active" : ""}>
                    {p}
                  </a>
                );
              })
            }
            <a
              href={currentPage < totalPages
                ? buildVlogCategoryPageHref(decodedCategory, currentPage + 1)
                : "#"}
              class={currentPage >= totalPages ? "disabled" : ""}>→</a
            >
          </nav>
        </>
      ) : (
        <div class="no-videos">
          <p>Ni videov na tej strani.</p>
        </div>
      )
    }
  </section>
</BaseLayout>

<style>
  .vlogi-page {
    padding: 2rem 0 4rem;
  }
  .vlogi-header {
    margin-bottom: 1.5rem;
  }
  .section-label {
    display: block;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 2.2px;
    color: var(--primary-base);
    margin-bottom: 0.5rem;
  }
  .section-title {
    font-family: var(--font-display);
    font-size: 2.625rem;
    font-weight: 700;
    margin: 0 0 0.25rem 0;
  }
  .section-subtitle {
    font-size: 15px;
    color: var(--grey-300);
    margin: 0;
  }
  .category-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }
  .filter-btn {
    padding: 8px 16px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    background: var(--grey-100);
    color: var(--black);
  }
  .filter-btn:hover,
  .filter-btn.active {
    background: var(--black);
    color: white;
  }
  .featured-section {
    background: rgba(230, 59, 46, 0.05);
    border: 1px solid rgba(230, 59, 46, 0.15);
    border-radius: 12.75px;
    padding: 21px;
    margin-bottom: 21px;
  }
  .featured-video-link {
    display: block;
    border-radius: 8.75px;
    overflow: hidden;
    aspect-ratio: 16/9;
    margin-bottom: 14px;
  }
  .featured-video-thumb {
    position: relative;
    width: 100%;
    height: 100%;
    background: var(--grey-200);
  }
  .featured-video-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .featured-placeholder {
    width: 100%;
    height: 100%;
    background: var(--grey-200);
  }
  .play-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.3);
  }
  .featured-section .play-icon {
    width: 48px;
    height: 48px;
  }
  .featured-meta {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .featured-title {
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: 700;
    line-height: 1.2;
    margin: 0;
  }
  .featured-title a {
    color: var(--black);
    text-decoration: none;
  }
  .featured-title a:hover {
    color: var(--primary-base);
  }
  .featured-date {
    font-size: 13px;
    color: var(--grey-300);
    margin: 0;
  }
  .video-list-title {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 600;
    margin: 0 0 14px 0;
  }
  .pagination {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2rem;
    align-items: center;
  }
  .pagination a {
    padding: 0.35rem 0.65rem;
    text-decoration: none;
    color: var(--black);
    border-radius: 6px;
    font-size: 14px;
  }
  .pagination a.active {
    background: var(--black);
    color: white;
  }
  .pagination a.disabled {
    pointer-events: none;
    opacity: 0.35;
  }
  .no-videos {
    padding: 4rem;
    text-align: center;
    color: var(--grey-400);
  }
</style>
