---
/**
 * Legacy /categories/:name/page/n → /blog/category/:name/page/n
 */
import { getCollection } from "astro:content";
import {
  CONTENT_TYPES,
  matchesCategory,
} from "../../../../data/categories";
import { buildCategoryPageHref } from "../../../../utils/urls";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog");
  const published = allPosts.filter((p) => !p.data.draft);
  const postCategories = [
    ...new Set(published.flatMap((p) => p.data.categories || [])),
  ];
  const categorySlugs = [...CONTENT_TYPES, ...postCategories];
  const paths: { params: { category: string; page: string } }[] = [];
  for (const cat of categorySlugs) {
    const posts = published.filter((p) => matchesCategory(p, cat));
    const totalPages = Math.ceil(posts.length / 6);
    for (let p = 2; p <= totalPages; p++) {
      paths.push({ params: { category: cat, page: String(p) } });
    }
  }
  return paths;
}

const { category, page } = Astro.params;
const decoded = category ? decodeURIComponent(category) : "";
const currentPage = parseInt(page ?? "1", 10);
const targetPath = buildCategoryPageHref(decoded, currentPage);
const canonical = new URL(targetPath, Astro.site).href;
---

<!doctype html>
<html lang="sl">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Preusmeritev…</title>
    <link rel="canonical" href={canonical} />
    <meta http-equiv="refresh" content={`0;url=${targetPath}`} />
  </head>
  <body>
    <p><a href={targetPath}>Nadaljuj na blog</a></p>
    <script is:inline define:vars={{ targetPath }}>
      location.replace(targetPath);
    </script>
  </body>
</html>
