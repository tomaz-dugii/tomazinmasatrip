---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BlogCard from "../../../components/BlogCard.astro";
import VideoSidebar from "../../../components/VideoSidebar.astro";
import { getCollection } from "astro:content";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../../consts";
import {
  getBlogFilterChips,
  isBlogPost,
  isVlogPost,
} from "../../../data/categories";
import { buildBlogPageHref, buildCategoryHref } from "../../../utils/urls";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog");
  const posts = allPosts
    .filter((p) => !p.data.draft && isBlogPost(p))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  const pageSize = 6;
  const totalPages = Math.max(1, Math.ceil(posts.length / pageSize));
  // Page 1 is /blog; only generate /blog/page/2+.
  if (totalPages <= 1) return [];
  return Array.from({ length: totalPages - 1 }, (_, i) => ({
    params: { page: String(i + 2) },
  }));
}

const { page } = Astro.params;
const currentPage = parseInt(page ?? "1", 10);

// --- Paginated blog list: pass current URL as `listFrom` for post “back” links ---
const allPosts = await getCollection("blog");
const published = allPosts
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const posts = published.filter((p) => isBlogPost(p));
const videos = published.filter((p) => isVlogPost(p));

const filterList = getBlogFilterChips(published);

const pageSize = 6;
const totalPages = Math.max(1, Math.ceil(posts.length / pageSize));
const start = (currentPage - 1) * pageSize;
const paginatedPosts = posts.slice(start, start + pageSize);
const listFrom = buildBlogPageHref(currentPage);
---

<BaseLayout
  title={`Blog - stran ${currentPage} | ${SITE_TITLE}`}
  description={SITE_DESCRIPTION}
  activePage="blog"
>
  <section class="blog-page">
    <div class="row blog-page-inner">
      <div class="col-xs-12 col-md-8 blog-main">
        <div class="blog-header">
          <span class="section-label">BLOG</span>
          <h1 class="section-title">Kaj dogaja na poti.</h1>
          <p class="section-subtitle">Kaj dogaja na poti in kod se potepava.</p>
        </div>
        <div class="category-filters">
          {
            filterList.map((cat) => (
              <a
                href={buildCategoryHref(cat)}
                class:list={["filter-btn", { active: cat === "Vse" }]}
              >
                {cat === "Vse" ? "VSE" : cat}
              </a>
            ))
          }
        </div>
        <div class="blog-list">
          {paginatedPosts.map((entry) => (
            <BlogCard entry={entry} listFrom={listFrom} />
          ))}
        </div>
        <nav class="pagination">
          <a
            href={currentPage > 1
              ? buildBlogPageHref(currentPage - 1)
              : "#"}
            class={currentPage <= 1 ? "disabled" : ""}>←</a
          >
          {
            Array.from({ length: Math.min(totalPages, 7) }, (_, i) => {
              const p = i + 1;
              const href = buildBlogPageHref(p);
              return (
                <a href={href} class={p === currentPage ? "active" : ""}>
                  {p}
                </a>
              );
            })
          }
          <a
            href={currentPage < totalPages
              ? buildBlogPageHref(currentPage + 1)
              : "#"}
            class={currentPage >= totalPages ? "disabled" : ""}>→</a
          >
        </nav>
      </div>
      <div class="col-xs-12 col-md-4 blog-sidebar">
        <VideoSidebar videos={videos} />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .blog-page {
    padding: 2rem 0 4rem;
  }
  .blog-header {
    margin-bottom: 1.5rem;
  }
  .section-label {
    display: block;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 1.5px;
    color: var(--primary-base);
    margin-bottom: 0.25rem;
  }
  .section-title {
    font-family: var(--font-display);
    font-size: 2.625rem;
    font-weight: 700;
    margin: 0 0 0.25rem 0;
  }
  .section-subtitle {
    font-size: 15px;
    color: var(--grey-400);
    margin: 0 0 1.5rem 0;
  }
  .category-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }
  .filter-btn {
    padding: 8px 16px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    background: var(--grey-100);
    color: var(--black);
  }
  .filter-btn:hover,
  .filter-btn.active {
    background: var(--black);
    color: white;
  }
  .blog-list {
    display: flex;
    flex-direction: column;
  }
</style>
