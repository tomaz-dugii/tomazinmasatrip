---
import BaseLayout from '../layouts/BaseLayout.astro';
import { aboutData } from '../data/about';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<BaseLayout title={`O naju | ${SITE_TITLE}`} description={SITE_DESCRIPTION} activePage="onaju">
  <section class="about-page">
    <h1 class="about-title">O naju</h1>
    <div class="about-intro">
      {aboutData.intro.map((p) => (
        <p>{p}</p>
      ))}
      <p class="about-quote">{aboutData.quote}</p>
    </div>
    <hr class="about-divider" />
    <div class="about-authors">
      {aboutData.authors.map((author) => (
        <div class="author-card">
          <div class="author-image-wrap">
            <img src={author.image} alt={author.name} class="author-image" loading="lazy" />
          </div>
          <h3 class="author-name">{author.name}</h3>
          <p class="author-bio">{author.bio}</p>
          <div class="author-social">
            <span class="social-label">Poveži me na social</span>
            <div class="social-icons">
              {author.social.map((s) => (
                <a href={s.url} target="_blank" rel="noopener noreferrer" class="social-icon" aria-label={s.label}>
                  {s.type === 'instagram' ? (
                    <svg viewBox="0 0 24 24" width="16" height="16"><path fill="currentColor" d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                  ) : (
                    <svg viewBox="0 0 24 24" width="16" height="16"><path fill="currentColor" d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                  )}
                </a>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .about-page {
    padding: 2rem 0 4rem;
  }
  .about-title {
    font-family: var(--font-display);
    font-size: 2.625rem;
    font-weight: 700;
    margin: 0 0 1.5rem 0;
  }
  .about-intro {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .about-intro p {
    font-size: 15px;
    line-height: 1.85;
    color: var(--grey-400);
    margin: 0;
  }
  .about-quote {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 16px;
    color: var(--black);
    margin: 0.5rem 0 0 0;
  }
  .about-divider {
    border: none;
    border-top: 1px solid rgba(45, 45, 45, 0.08);
    margin: 2.5rem 0;
  }
  .about-authors {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3.5rem;
  }
  .author-card {
    display: flex;
    flex-direction: column;
  }
  .author-image-wrap {
    border-radius: 14px;
    overflow: hidden;
    aspect-ratio: 3/4;
    background: var(--grey-100);
    margin-bottom: 1.5rem;
  }
  .author-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .author-name {
    font-family: var(--font-display);
    font-size: 1.14rem;
    font-weight: 700;
    margin: 0 0 0.75rem 0;
  }
  .author-bio {
    font-size: 14px;
    line-height: 1.75;
    color: var(--grey-500);
    margin: 0 0 1.5rem 0;
  }
  .author-social {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .social-label {
    font-size: 12px;
    font-weight: 500;
    color: var(--grey-300);
  }
  .social-icons {
    display: flex;
    gap: 0.5rem;
  }
  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 35px;
    height: 35px;
    border: 1px solid rgba(45, 45, 45, 0.15);
    border-radius: 999px;
    color: var(--black);
  }
  .social-icon:hover {
    color: var(--primary-base);
    border-color: var(--primary-base);
  }
  @media (max-width: 768px) {
    .about-authors {
      grid-template-columns: 1fr;
    }
  }
</style>
