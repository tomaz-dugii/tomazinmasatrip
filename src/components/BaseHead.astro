---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../styles/global.css";
import type { ImageMetadata } from "astro";
import FallbackImage from "../assets/blog-placeholder-1.jpg";
import { SITE_TITLE } from "../consts";

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata | string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image } = Astro.props;
const imageSrc = image
  ? typeof image === "string"
    ? image
    : image.src
  : FallbackImage.src;
const imageUrl = imageSrc.startsWith("http")
  ? imageSrc
  : new URL(imageSrc.startsWith("/") ? imageSrc : "/" + imageSrc, Astro.site)
      .href;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />

<!-- Google Analytics: deferred until analytics consent (see CookieConsent). -->
<script is:inline>
(function () {
  var GA_ID = "G-JNVFHPVQG6";
  var STORAGE_KEY = "cookie-consent";
  var VERSION = 1;

  function parseConsent(raw) {
    if (raw == null || raw === "") return null;
    if (raw === "true") {
      return { analytics: true, marketing: true };
    }
    try {
      var o = JSON.parse(raw);
      if (
        o &&
        typeof o === "object" &&
        o.version === VERSION &&
        typeof o.analytics === "boolean" &&
        typeof o.marketing === "boolean"
      ) {
        return { analytics: o.analytics, marketing: o.marketing };
      }
    } catch (e) {}
    return null;
  }

  function analyticsAllowed() {
    try {
      var c = parseConsent(localStorage.getItem(STORAGE_KEY));
      return c && c.analytics === true;
    } catch (e) {
      return false;
    }
  }

  var gaInjected = false;

  window.__loadGoogleAnalyticsIfConsented = function loadGoogleAnalyticsIfConsented() {
    if (gaInjected || !analyticsAllowed()) return;
    gaInjected = true;

    window.dataLayer = window.dataLayer || [];
    function gtag() {
      dataLayer.push(arguments);
    }
    window.gtag = gtag;

    gtag("js", new Date());
    gtag("config", GA_ID);

    var s = document.createElement("script");
    s.async = true;
    s.src =
      "https://www.googletagmanager.com/gtag/js?id=" +
      encodeURIComponent(GA_ID);
    document.head.appendChild(s);
  };

  window.__loadGoogleAnalyticsIfConsented();
})();
</script>

<!-- Favicon package generated by Favicon.im Generator -->
<link rel="icon" type="image/x-icon" href="images/favicon/favicon.ico" />
<link
  rel="icon"
  type="image/png"
  sizes="16x16"
  href="images/favicon//favicon-16x16.png"
/>
<link
  rel="icon"
  type="image/png"
  sizes="32x32"
  href="images/favicon/favicon-32x32.png"
/>
<link
  rel="apple-touch-icon"
  sizes="180x180"
  href="images/favicon/apple-touch-icon.png"
/>
<link
  rel="icon"
  type="image/png"
  sizes="192x192"
  href="images/favicon/android-chrome-192x192.png"
/>
<link
  rel="icon"
  type="image/png"
  sizes="512x512"
  href="images/favicon/android-chrome-512x512.png"
/>
<link rel="icon" type="image/svg+xml" href="images/favicon/favicon.svg" />
<meta name="theme-color" content="#ffffff" />

<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={new URL("rss.xml", Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Fonts loaded via Google Fonts in global.css -->

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrl} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={imageUrl} />
