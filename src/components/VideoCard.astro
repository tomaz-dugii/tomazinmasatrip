---
import type { CollectionEntry } from "astro:content";
import { Play } from "@lucide/astro";
import { buildPostHref } from "../utils/urls";

interface Props {
  entry: CollectionEntry<"blog">;
  featured?: boolean;
  listFrom?: string;
}

const { entry, featured = false, listFrom } = Astro.props;
const { id, data } = entry;
const formattedDate = new Date(data.pubDate).toLocaleDateString("sl-SI", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const metaText = data.readTime
  ? `${formattedDate} – ${data.readTime} branja`
  : formattedDate;
const postHref = buildPostHref(id, listFrom ? { from: listFrom } : undefined);
---

<a href={postHref} class={`video-card ${featured ? "featured" : ""}`}>
  <div class="video-card-thumb">
    {
      data.thumbnail ? (
        <img
          src={data.thumbnail}
          alt={data.title}
          loading={featured ? "eager" : "lazy"}
        />
      ) : (
        <div class="thumb-placeholder" />
      )
    }
    <div class="play-overlay">
      <span class="play-icon" aria-hidden="true">
        <Play size={12} stroke-width={2.5} />
      </span>
    </div>
  </div>
  <div class="video-card-info">
    <h4 class="video-card-title">{data.title}</h4>
    <span class="video-card-meta">{metaText}</span>
  </div>
</a>

<style>
  .video-card {
    display: flex;
    gap: 14px;
    padding: 12px;
    border-radius: 12.75px;
    text-decoration: none;
    color: inherit;
    border: 1px solid transparent;
    transition:
      background 0.2s,
      border-color 0.2s;
  }
  .video-card:hover {
    background: var(--primary-hover-bg);
  }
  .video-card.featured {
    background: var(--primary-featured-bg);
    border-color: var(--primary-featured-border);
  }
  .video-card.featured .video-card-title {
    color: var(--primary-base);
  }
  .video-card-thumb {
    position: relative;
    flex-shrink: 0;
    width: 179px;
    height: 118px;
    border-radius: 8.75px;
    overflow: hidden;
    background: var(--grey-100);
  }
  .video-card-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .thumb-placeholder {
    width: 100%;
    height: 100%;
    background: var(--grey-200);
  }
  .play-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.3);
  }
  .video-card-info {
    display: flex;
    flex-direction: column;
    gap: 3.5px;
    min-width: 0;
  }
  .video-card-title {
    font-family: var(--font-primary);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.4;
    margin: 0;
    color: var(--black);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .video-card-meta {
    font-size: 11px;
    font-weight: 500;
    color: var(--grey-300);
  }
  @media (max-width: 640px) {
    .video-card-thumb {
      width: 120px;
      height: 79px;
    }
  }
</style>
