---
import "glightbox/dist/css/glightbox.min.css";

interface Props {
  images: string[];
}

const { images } = Astro.props;

function filenameToAlt(path: string): string {
  const filename = path.split("/").pop()?.replace(/\.[^.]+$/, "") ?? "";
  return filename
    .replace(/_/g, " ")
    .replace(/\b\w/g, (c) => c.toUpperCase());
}
---

{images.length > 0 && (
  <div class="gallery-wrapper">
    <h3 class="gallery-title">Galerija</h3>
    <div class="gallery">
      {images.map((path) => (
        <a href={path} class="glightbox" data-gallery="post-gallery">
          <img src={path} alt={filenameToAlt(path)} loading="lazy" />
        </a>
      ))}
    </div>
  </div>
)}

{images.length > 0 && (
  <script>
    import GLightbox from "glightbox";

    function initLightbox() {
      GLightbox({
        selector: ".glightbox",
        touchNavigation: true,
        loop: true,
      });
    }
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initLightbox);
    } else {
      initLightbox();
    }
  </script>
)}

<style>
  .gallery-wrapper {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(45, 45, 45, 0.08);
  }

  .gallery-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0 0 1rem 0;
    color: var(--black);
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 1rem;
  }

  .gallery a {
    display: block;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: var(--shadow-image);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .gallery a:hover {
    transform: scale(1.02);
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.12);
  }

  .gallery img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 4/3;
    display: block;
  }

  @media (min-width: 640px) {
    .gallery {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 960px) {
    .gallery {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
