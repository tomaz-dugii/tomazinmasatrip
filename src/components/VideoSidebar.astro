---
import type { CollectionEntry } from 'astro:content';

interface Props {
  videos: CollectionEntry<'blog'>[];
}

const { videos } = Astro.props;
---

<aside class="video-sidebar">
  <div class="sidebar-header">
    <span class="section-label">VIDEO</span>
    <h2 class="section-title">Zadnji Videi</h2>
    <p class="section-subtitle">Kaj dogaja na poti, ampak v videu.</p>
  </div>
  <div class="video-list">
    {videos.slice(0, 5).map((entry) => {
      const { id, data } = entry;
      const formattedDate = new Date(data.pubDate).toLocaleDateString('sl-SI', { year: 'numeric', month: 'long', day: 'numeric' });
      return (
        <a href={`/posts/${id}`} class="video-item">
          <div class="video-thumb">
            {data.thumbnail ? (
              <img src={data.thumbnail} alt={data.title} loading="lazy" />
            ) : (
              <div class="video-placeholder"></div>
            )}
            <span class="play-icon">▶</span>
          </div>
          <div class="video-info">
            <span class="video-title">{data.title}</span>
            <span class="video-meta">{formattedDate}{data.readTime ? ` · ${data.readTime}` : ''}</span>
          </div>
        </a>
      );
    })}
  </div>
  <a href="/vlogi" class="sidebar-link">Vsi videi →</a>
</aside>

<style>
  .video-sidebar {
    background: var(--white);
    padding: 1.5rem;
    border-radius: 14px;
    box-shadow: 0 2px 20px rgba(0, 0, 0, 0.06);
  }
  .sidebar-header {
    margin-bottom: 1.5rem;
  }
  .section-label {
    display: block;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 1.5px;
    color: var(--primary-base);
    margin-bottom: 0.25rem;
  }
  .section-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0 0 0.25rem 0;
  }
  .section-subtitle {
    font-size: 13px;
    color: var(--grey-400);
    margin: 0;
  }
  .video-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .video-item {
    display: flex;
    gap: 0.75rem;
    text-decoration: none;
    color: inherit;
  }
  .video-item:hover .video-title {
    color: var(--primary-base);
  }
  .video-thumb {
    position: relative;
    flex-shrink: 0;
    width: 80px;
    height: 60px;
    border-radius: 8px;
    overflow: hidden;
    background: var(--grey-100);
  }
  .video-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .play-icon {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    color: white;
    text-shadow: 0 1px 3px rgba(0,0,0,0.5);
  }
  .video-placeholder {
    width: 100%;
    height: 100%;
    background: var(--grey-200);
  }
  .video-info {
    min-width: 0;
  }
  .video-title {
    display: block;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.3;
    margin-bottom: 0.25rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .video-meta {
    font-size: 11px;
    color: var(--grey-400);
  }
  .sidebar-link {
    display: inline-block;
    margin-top: 1rem;
    font-size: 13px;
    font-weight: 500;
    color: var(--black);
  }
  .sidebar-link:hover {
    color: var(--primary-base);
  }
</style>
