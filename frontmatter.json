{
  "$schema": "https://frontmatter.codes/frontmatter.schema.json",
  "frontMatter.framework.id": "astro",
  "frontMatter.preview.host": "http://localhost:4321",
  "frontMatter.content.publicFolder": "public",
  "frontMatter.data.files": [
    {
      "id": "authors",
      "title": "Authors",
      "file": "[[workspace]]/data/authors.json",
      "labelField": "name",
      "singleEntry": false,
      "fileType": "json",
      "schema": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "name"
          ],
          "properties": {
            "id": {
              "type": "string",
              "title": "ID"
            },
            "name": {
              "type": "string",
              "title": "Name"
            },
            "image": {
              "type": "string",
              "title": "Image"
            },
            "bio": {
              "type": "string",
              "title": "Bio"
            },
            "social": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "frontMatter.content.filters": [
    "contentFolders",
    "tags",
    "categories",
    {
      "title": "Featured video",
      "name": "featured"
    }
  ],
  "frontMatter.content.pageFolders": [
    {
      "title": "blog",
      "path": "[[workspace]]/src/content/blog",
      "contentTypes": [
        "blog-post",
        "vlog-post"
      ]
    }
  ],
  "frontMatter.taxonomy.contentTypes": [
    {
      "name": "blog-post",
      "pageBundle": false,
      "previewPath": "'blog'",
      "filePrefix": null,
      "clearEmpty": true,
      "template": "[[workspace]]/.frontmatter/templates/Blog_post.md",
      "fields": [
        {
          "title": "Title",
          "name": "title",
          "type": "string",
          "single": true
        },
        {
          "title": "Description",
          "name": "description",
          "type": "string"
        },
        {
          "title": "Publishing date",
          "name": "pubDate",
          "type": "datetime",
          "default": "{{now}}",
          "isPublishDate": true
        },
        {
          "title": "Vrsta vsebine",
          "name": "contentType",
          "type": "choice",
          "choices": [
            "Blog",
            "Vlog"
          ]
        },
        {
          "title": "Destinacije",
          "name": "categories",
          "type": "categories"
        },
        {
          "title": "Tags",
          "name": "tags",
          "type": "tags"
        },
        {
          "title": "Draft",
          "name": "draft",
          "type": "boolean"
        },
        {
          "title": "Video",
          "name": "video",
          "type": "boolean"
        },
        {
          "title": "Featured video",
          "name": "featured",
          "type": "boolean",
          "description": "Prikaži ta video kot izbrani na strani Vlogi. Samo en video naj bo imel oznako true. Če noben nima true, se prikaže najnovejši."
        },
        {
          "title": "Author",
          "name": "authorId",
          "type": "dataFile",
          "dataFileId": "authors",
          "dataFileKey": "id",
          "dataFileValue": "name",
          "default": "tomaz"
        },
        {
          "title": "Read time",
          "name": "readTime",
          "type": "string"
        },
        {
          "title": "Thumbnail",
          "name": "thumbnail",
          "type": "image",
          "isPreviewImage": true
        },
        {
          "title": "Feature image",
          "name": "featureImage",
          "type": "image"
        },
        {
          "title": "YouTube URL",
          "name": "youtubeUrl",
          "type": "string"
        },
        {
          "title": "Show on sidebar",
          "name": "showOnSidebar",
          "type": "boolean"
        },
        {
          "name": "galleryImages",
          "type": "image",
          "multiple": true
        }
      ]
    },
    {
      "name": "vlog-post",
      "pageBundle": false,
      "previewPath": "'blog'",
      "filePrefix": null,
      "clearEmpty": true,
      "template": "[[workspace]]/.frontmatter/templates/Vlog_post.md",
      "fields": [
        {
          "title": "Title",
          "name": "title",
          "type": "string",
          "single": true
        },
        {
          "title": "Description",
          "name": "description",
          "type": "string"
        },
        {
          "title": "Publishing date",
          "name": "pubDate",
          "type": "datetime",
          "default": "{{now}}",
          "isPublishDate": true
        },
        {
          "title": "Vrsta vsebine",
          "name": "contentType",
          "type": "choice",
          "choices": [
            "Blog",
            "Vlog"
          ]
        },
        {
          "title": "Destinacije",
          "name": "categories",
          "type": "categories"
        },
        {
          "title": "Tags",
          "name": "tags",
          "type": "tags"
        },
        {
          "title": "Draft",
          "name": "draft",
          "type": "boolean"
        },
        {
          "title": "Video",
          "name": "video",
          "type": "boolean"
        },
        {
          "title": "Featured video",
          "name": "featured",
          "type": "boolean",
          "description": "Prikaži ta video kot izbrani na strani Vlogi. Samo en video naj bo imel oznako true. Če noben nima true, se prikaže najnovejši."
        },
        {
          "title": "Author",
          "name": "authorId",
          "type": "dataFile",
          "dataFileId": "authors",
          "dataFileKey": "id",
          "dataFileValue": "name",
          "default": "tomaz"
        },
        {
          "title": "Read time",
          "name": "readTime",
          "type": "string"
        },
        {
          "title": "Thumbnail",
          "name": "thumbnail",
          "type": "image",
          "isPreviewImage": true
        },
        {
          "title": "Feature image",
          "name": "featureImage",
          "type": "image"
        },
        {
          "title": "YouTube URL",
          "name": "youtubeUrl",
          "type": "string"
        },
        {
          "title": "Show on sidebar",
          "name": "showOnSidebar",
          "type": "boolean"
        },
        {
          "name": "galleryImages",
          "type": "image",
          "multiple": true
        }
      ]
    },
    {
      "name": "blog",
      "previewPath": "'blog'",
      "pageBundle": false,
      "clearEmpty": true,
      "fields": [
        {
          "name": "title",
          "type": "string",
          "single": true,
          "required": true
        },
        {
          "name": "description",
          "type": "string",
          "single": true
        },
        {
          "name": "pubDate",
          "type": "datetime",
          "default": "{{now}}",
          "required": true
        },
        {
          "name": "updatedDate",
          "type": "datetime",
          "default": "{{now}}"
        },
        {
          "name": "heroImage",
          "type": "image",
          "isPreviewImage": true
        },
        {
          "name": "draft",
          "type": "draft"
        },
        {
          "name": "contentType",
          "type": "choice",
          "choices": [
            "Blog",
            "Vlog"
          ]
        },
        {
          "name": "tags",
          "type": "tags"
        },
        {
          "name": "categories",
          "type": "categories"
        },
        {
          "name": "video",
          "type": "boolean"
        },
        {
          "name": "featured",
          "type": "boolean"
        },
        {
          "name": "authorId",
          "type": "string"
        },
        {
          "name": "readTime",
          "type": "string",
          "single": true
        },
        {
          "name": "thumbnail",
          "type": "string",
          "single": true
        },
        {
          "name": "featureImage",
          "type": "image"
        },
        {
          "name": "youtubeUrl",
          "type": "string",
          "single": true
        },
        {
          "name": "showOnSidebar",
          "type": "boolean"
        },
        {
          "name": "galleryImages",
          "type": "image",
          "multiple": true
        }
      ]
    }
  ],
  "frontMatter.content.snippets": {
    "Image": {
      "description": "Insert markdown image from media panel. Use when selecting an image from the media picker.",
      "body": "![[[alt]]]([[&mediaUrl]])",
      "isMediaSnippet": true,
      "fields": [
        {
          "name": "alt",
          "title": "Alt text",
          "type": "string",
          "default": ""
        }
      ]
    }
  }
}