{
  "$schema": "https://frontmatter.codes/frontmatter.schema.json",
  "frontMatter.framework.id": "astro",
  "frontMatter.preview.host": "http://localhost:4321",
  "frontMatter.content.publicFolder": "public",
  "frontMatter.content.pageFolders": [
    {
      "title": "blog",
      "path": "[[workspace]]/src/content/blog",
      "contentTypes": ["blog-post", "vlog-post"]
    }
  ],
  "frontMatter.taxonomy.contentTypes": [
    {
      "name": "blog-post",
      "pageBundle": false,
      "previewPath": "'blog'",
      "filePrefix": null,
      "clearEmpty": true,
      "template": "[[workspace]]/.frontmatter/templates/Blog_post.md",
      "fields": [
        {
          "title": "Title",
          "name": "title",
          "type": "string",
          "single": true
        },
        {
          "title": "Description",
          "name": "description",
          "type": "string"
        },
        {
          "title": "Publishing date",
          "name": "pubDate",
          "type": "datetime",
          "default": "{{now}}",
          "isPublishDate": true
        },
        {
          "title": "Vrsta vsebine",
          "name": "contentType",
          "type": "choice",
          "choices": ["Blog", "Vlog"]
        },
        {
          "title": "Destinacije",
          "name": "categories",
          "type": "categories"
        },
        {
          "title": "Tags",
          "name": "tags",
          "type": "tags"
        },
        {
          "title": "Draft",
          "name": "draft",
          "type": "boolean"
        },
        {
          "title": "Video",
          "name": "video",
          "type": "boolean"
        },
        {
          "title": "Second author",
          "name": "secondAuthor",
          "type": "boolean"
        },
        {
          "title": "Read time",
          "name": "readTime",
          "type": "string"
        },
        {
          "title": "Thumbnail",
          "name": "thumbnail",
          "type": "image",
          "isPreviewImage": true
        },
        {
          "title": "Feature image",
          "name": "featureImage",
          "type": "image"
        },
        {
          "title": "YouTube URL",
          "name": "youtubeUrl",
          "type": "string"
        },
        {
          "title": "Tranding",
          "name": "tranding",
          "type": "boolean"
        }
      ]
    },
    {
      "name": "vlog-post",
      "pageBundle": false,
      "previewPath": "'blog'",
      "filePrefix": null,
      "clearEmpty": true,
      "template": "[[workspace]]/.frontmatter/templates/Vlog_post.md",
      "fields": [
        {
          "title": "Title",
          "name": "title",
          "type": "string",
          "single": true
        },
        {
          "title": "Description",
          "name": "description",
          "type": "string"
        },
        {
          "title": "Publishing date",
          "name": "pubDate",
          "type": "datetime",
          "default": "{{now}}",
          "isPublishDate": true
        },
        {
          "title": "Vrsta vsebine",
          "name": "contentType",
          "type": "choice",
          "choices": ["Blog", "Vlog"]
        },
        {
          "title": "Destinacije",
          "name": "categories",
          "type": "categories"
        },
        {
          "title": "Tags",
          "name": "tags",
          "type": "tags"
        },
        {
          "title": "Draft",
          "name": "draft",
          "type": "boolean"
        },
        {
          "title": "Video",
          "name": "video",
          "type": "boolean"
        },
        {
          "title": "Second author",
          "name": "secondAuthor",
          "type": "boolean"
        },
        {
          "title": "Read time",
          "name": "readTime",
          "type": "string"
        },
        {
          "title": "Thumbnail",
          "name": "thumbnail",
          "type": "image",
          "isPreviewImage": true
        },
        {
          "title": "Feature image",
          "name": "featureImage",
          "type": "image"
        },
        {
          "title": "YouTube URL",
          "name": "youtubeUrl",
          "type": "string"
        },
        {
          "title": "Tranding",
          "name": "tranding",
          "type": "boolean"
        }
      ]
    }
  ]
}
